{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:best-practices",
    ":label(dependencies)",
    ":semanticCommits"
  ],

  "ignorePresets": ["helpers:pinGitHubActionDigests"],

  "enabledManagers": [],

  "prHourlyLimit": 4,

  "customManagers": [
    {
      "description": "Track the gh-actions-lock extension pin in workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "gh extension install (?<depName>github/gh-actions-lock) --pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],

  "packageRules": [
    {
      "description": "Automerge dependency pins",
      "matchUpdateTypes": ["pin"],
      "automerge": true
    },
    {
      "description": "Automerge stable non-major updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Automerge non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true
    },
    {
      "description": "Wait a week before proposing GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge lock file maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Require approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
